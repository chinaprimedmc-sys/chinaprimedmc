{
  "name": "china-prime-dmc-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm media:map && next dev --webpack",
    "build": "pnpm media:map && pnpm media:social && pnpm audit:destinations && pnpm audit:journey-links && pnpm audit:journal-search && pnpm audit:journal-editorial && pnpm audit:journal-quality && pnpm audit:journal-governance && next build --webpack",
    "start": "next start",
    "preview": "node scripts/start-local-preview.mjs",
    "preview:fresh": "pnpm build && pnpm preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:journey": "node --test tests/journey-brief.test.mjs tests/journey-classification.test.mjs tests/mutianyu-product.test.mjs tests/shanghai-search.test.mjs tests/xian-search.test.mjs tests/chengdu-search.test.mjs tests/guilin-search.test.mjs tests/first-china-search.test.mjs tests/easier-pace-search.test.mjs tests/published-prices.test.mjs tests/journey-filter.test.mjs tests/journey-match.test.mjs tests/journey-explorer.test.mjs tests/review-board.test.mjs",
    "test:experience": "node scripts/test-experience.mjs",
    "audit:destinations": "node scripts/audit-destinations.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:home-search": "node scripts/audit-home-search.mjs",
    "audit:structured-data": "node scripts/audit-structured-data.mjs",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:images:rendered": "node scripts/audit-rendered-images.mjs",
    "prewarm:tour-images": "node scripts/prewarm-tour-images.mjs",
    "audit:journey-links": "node scripts/audit-journey-journal-links.mjs",
    "audit:journal-search": "node scripts/audit-journal-search-strategy.mjs",
    "audit:journal-editorial": "node scripts/audit-journal-editorial.mjs",
    "audit:journal-quality": "node scripts/audit-journal-quality.mjs",
    "audit:journal-governance": "node scripts/audit-journal-governance.mjs",
    "audit:journal-rendered": "node scripts/audit-journal-rendered.mjs",
    "audit:blog-conversion": "node scripts/audit-blog-conversion.mjs",
    "intel:score": "node scripts/score-product-opportunities.mjs",
    "intel:validate": "node scripts/validate-product-intelligence.mjs",
    "intel:db": "node scripts/build-product-intelligence-db.mjs",
    "intel:update": "node scripts/update-product-intelligence.mjs",
    "intel:refresh": "pnpm intel:score && pnpm intel:validate && pnpm intel:db && pnpm intel:update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "media:social": "tsx scripts/media/build-social-cards.ts",
    "media:portrait": "node scripts/media/prepare-portrait.mjs",
    "audit:media": "node scripts/media/audit-library.mjs",
    "test:browser": "playwright test",
    "audit:links": "node scripts/audit-local-links.mjs",
    "audit:performance": "lhci autorun",
    "check:release": "node scripts/check-release.mjs",
    "test:route-map": "tsx --test tests/route-map.test.ts",
    "media:map": "node scripts/media/prepare-map-worker.mjs",
    "test:unit": "node --test tests/*.test.mjs && pnpm test:route-map"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-select": "^2.2.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "maplibre-gl": "^6.17.0",
    "motion": "^14.11.1",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "linkinator": "^8.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.18.1"
}
